---
import '../styles/global.css';
import Icon from '../components/Icon.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'Ruth Mutua: platform & cloud engineer working on Kubernetes, Terraform, cloud security and reliability.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const fullTitle = title ? `${title} | Ruth Mutua` : 'Ruth Mutua | Platform & Cloud Engineer';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06080d" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Ruth Mutua" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ruth Mutua, Platform & Cloud Engineer: Kubernetes and the art of not getting paged." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/"><span class="monogram">RM</span><span class="name">ruth.mutua</span></a>
        <nav class="nav" aria-label="Main">
          <a href="/#work">Work</a>
          <a href="/#stack" class="hide-sm">Stack</a>
          <a href="/#writing">Writing</a>
          <a href="/#about" class="hide-sm">About</a>
          <a href="/#life" class="hide-sm">Life</a>
          <a href="/#contact" class="btn btn-sm">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>© {new Date().getFullYear()} Ruth Ndinda Mutua · Nairobi, Kenya</span>
        <div class="socials">
          <a href="https://github.com/Ruth-mutua/" aria-label="GitHub"><Icon name="github" mono /></a>
          <a href="https://www.linkedin.com/in/ruth-mutua-19a66b1b8" aria-label="LinkedIn"><Icon name="linkedin" /></a>
          <a href="mailto:crnmndinda@gmail.com" aria-label="Email"><Icon name="mail" /></a>
        </div>
      </div>
    </footer>

    <script>
      const els = document.querySelectorAll('.reveal');
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
      );
      els.forEach((el) => io.observe(el));

      // Hero: type out each word, pause, delete, move to the next.
      const typed = document.querySelector('.typed');
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (typed instanceof HTMLElement && !still) {
        const words = (typed.dataset.words || '').split(',');
        let w = 0, i = words[0].length, deleting = true;
        const tick = () => {
          const word = words[w];
          if (deleting) {
            i--;
            if (i <= 0) { deleting = false; w = (w + 1) % words.length; }
          } else {
            i++;
            if (i >= words[w].length) { deleting = true; typed.textContent = words[w]; return setTimeout(tick, 1800); }
          }
          typed.textContent = (deleting ? word : words[w]).slice(0, Math.max(i, 0));
          setTimeout(tick, deleting ? 55 : 95);
        };
        setTimeout(tick, 2200);
      }
    </script>
  </body>
</html>
