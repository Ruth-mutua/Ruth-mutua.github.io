---
// Illustrated covers for the capability cards. Pure SVG, scaled to fit the card.
// Every gradient id is prefixed with the cover id so several covers can share a page.
// Animations live in an inline <style> inside the SVG, so the same markup also works
// as a standalone image (the GitHub profile cards are extracted from the build).
// Every animation only adds motion: the resting state always shows the full picture.
interface Props {
  id: string;
}
const { id } = Astro.props;
const p = (s: string) => `${id}-${s}`;
const u = (s: string) => `url(#${id}-${s})`;
const mono = 'JetBrains Mono Variable, JetBrains Mono, Fira Code, Menlo, Consolas, monospace';
---

<svg viewBox="0 0 800 450" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
  <style is:inline>{`
    .cv-flow { animation: cv-flow 1.6s linear infinite; }
    @keyframes cv-flow { to { stroke-dashoffset: -24; } }
    .cv-pulse { animation: cv-pulse 2.4s ease-in-out infinite; }
    @keyframes cv-pulse { 50% { opacity: 0.45; } }
    .cv-blink { animation: cv-blink 1.4s steps(1) infinite; }
    @keyframes cv-blink { 50% { opacity: 0.2; } }
    .cv-d1 { animation-delay: .3s; } .cv-d2 { animation-delay: .6s; } .cv-d3 { animation-delay: .9s; } .cv-d4 { animation-delay: 1.2s; }
    @media (prefers-reduced-motion: reduce) { .cv-flow, .cv-pulse, .cv-blink { animation: none; } }
  `}</style>
  <defs>
    <linearGradient id={p('bg')} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#0c1220" />
      <stop offset="1" stop-color="#080b13" />
    </linearGradient>
    <linearGradient id={p('grad')} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#22d3ee" />
      <stop offset="0.55" stop-color="#818cf8" />
      <stop offset="1" stop-color="#c084fc" />
    </linearGradient>
    <radialGradient id={p('glow')} cx="0.7" cy="0.35" r="0.6">
      <stop offset="0" stop-color="#818cf8" stop-opacity="0.35" />
      <stop offset="1" stop-color="#818cf8" stop-opacity="0" />
    </radialGradient>
    <radialGradient id={p('glow2')} cx="0.2" cy="0.8" r="0.55">
      <stop offset="0" stop-color="#22d3ee" stop-opacity="0.22" />
      <stop offset="1" stop-color="#22d3ee" stop-opacity="0" />
    </radialGradient>
    <pattern id={p('grid')} width="32" height="32" patternUnits="userSpaceOnUse">
      <path d="M32 0H0V32" fill="none" stroke="#94a3b8" stroke-opacity="0.07" stroke-width="1" />
    </pattern>
  </defs>

  <rect width="800" height="450" rx="20" fill={u('bg')} />
  <rect width="800" height="450" fill={u('grid')} />
  <rect width="800" height="450" fill={u('glow')} />
  <rect width="800" height="450" fill={u('glow2')} />

  {id === 'kubernetes' && (
    <g font-family={mono}>
      {['staging', 'production', 'dr'].map((env, e) => (
        <g transform={`translate(${60 + e * 235} 70)`}>
          <rect width="210" height="250" rx="18" fill="#0f1729" stroke={e === 1 ? u('grad') : '#94a3b8'} stroke-opacity={e === 1 ? 0.9 : 0.25} stroke-width={e === 1 ? 2 : 1} />
          <text x="18" y="32" font-size="13" fill={e === 1 ? '#67e8f9' : '#94a3b8'}>{`ns: ${env}`}</text>
          {Array.from({ length: e === 1 ? 6 : e === 0 ? 4 : 2 }).map((_, n) => {
            const x = 52 + (n % 3) * 54;
            const y = 90 + Math.floor(n / 3) * 70;
            const c = n % 3 === 1 ? '#c084fc' : '#22d3ee';
            return (
              <polygon class={`cv-pulse cv-d${(n % 4) + 1}`} transform={`translate(${x} ${y})`} points="0,-24 21,-12 21,12 0,24 -21,12 -21,-12" fill={c} fill-opacity="0.2" stroke={c} stroke-opacity="0.85" stroke-width="1.5" />
            );
          })}
          <text x="18" y="232" font-size="11.5" fill="#64708a">{e === 1 ? 'replicas: 6 · hpa ↑' : e === 0 ? 'replicas: 4' : 'replicas: 2 · standby'}</text>
        </g>
      ))}
      <text x="60" y="372" font-size="13" fill="#94a3b8"><tspan fill="#34d399">$</tspan> kubectl get pods -A</text>
      <text x="60" y="398" font-size="13" fill="#34d399">all pods Running · network policies: default-deny<tspan class="cv-blink"> ▍</tspan></text>
    </g>
  )}

  {id === 'iac' && (
    <g font-family={mono}>
      <g transform="translate(50 50)">
        <rect width="460" height="300" rx="16" fill="#0f1729" stroke="#94a3b8" stroke-opacity="0.25" />
        <circle cx="20" cy="20" r="5" fill="#f87171" /><circle cx="36" cy="20" r="5" fill="#fbbf24" /><circle cx="52" cy="20" r="5" fill="#34d399" />
        <line x1="0" y1="38" x2="460" y2="38" stroke="#94a3b8" stroke-opacity="0.15" />
        <g font-size="13.5">
          <text x="20" y="70" fill="#e2e8f0"><tspan fill="#34d399">$</tspan> terraform plan</text>
          <text x="20" y="100" fill="#34d399">+ module.cluster.kubernetes_cluster</text>
          <text x="20" y="124" fill="#34d399">+ module.network.private_endpoint</text>
          <text x="20" y="148" fill="#fbbf24">~ module.dns.record["api"]</text>
          <text x="20" y="178" fill="#cbd5e1">Plan: <tspan fill="#34d399">2 to add</tspan>, <tspan fill="#fbbf24">1 to change</tspan>, 0 to destroy.</text>
          <text x="20" y="214" fill="#e2e8f0"><tspan fill="#34d399">$</tspan> kustomize build overlays/production</text>
          <text x="20" y="244" fill="#e2e8f0"><tspan fill="#34d399">$</tspan> terraform apply</text>
          <text x="20" y="272" fill="#34d399">Apply complete!<tspan class="cv-blink" fill="#22d3ee"> ▍</tspan></text>
        </g>
      </g>
      {['commit', 'build', 'staging', 'production'].map((s, i) => (
        <g>
          {i < 3 && <path d={`M${590} ${110 + i * 80 + 22} L590 ${110 + (i + 1) * 80 - 2}`} stroke={u('grad')} stroke-width="3" stroke-dasharray="6 6" class="cv-flow" />}
          <rect x="545" y={88 + i * 80} width="190" height="44" rx="12" fill="#0f1729" stroke={i === 3 ? '#34d399' : '#818cf8'} stroke-opacity="0.6" />
          <circle cx="570" cy={110 + i * 80} r="6" fill={i === 3 ? '#34d399' : '#818cf8'} class={`cv-pulse cv-d${i + 1}`} />
          <text x="588" y={115 + i * 80} font-size="14" fill="#e2e8f0">{s}</text>
        </g>
      ))}
    </g>
  )}

  {id === 'security' && (
    <g font-family={mono}>
      {[
        [120, 'allow', '#34d399'],
        [180, 'deny', '#f87171'],
        [240, 'allow', '#34d399'],
        [300, 'deny', '#f87171'],
      ].map(([y, verdict, c], i) => (
        <g>
          <path d={`M60 ${y} L330 ${y}`} stroke={c} stroke-opacity="0.6" stroke-width="2.5" stroke-dasharray="6 8" class="cv-flow" />
          <rect x="40" y={Number(y) - 14} width="70" height="28" rx="8" fill="#0f1729" stroke="#94a3b8" stroke-opacity="0.3" />
          <text x="75" y={Number(y) + 4.5} text-anchor="middle" font-size="11.5" fill="#94a3b8">{`req-${i + 1}`}</text>
          <text x="250" y={Number(y) - 10} font-size="11.5" fill={c} class={verdict === 'deny' ? `cv-blink cv-d${i}` : undefined}>{verdict === 'deny' ? '✕ deny' : '✓ allow'}</text>
          {verdict === 'allow' && <path d={`M470 ${y} L560 210`} stroke="#34d399" stroke-opacity="0.5" stroke-width="2" stroke-dasharray="6 8" class="cv-flow" />}
        </g>
      ))}
      <g transform="translate(400 210)">
        <path d="M0 -110 L80 -80 L80 0 C 80 60 40 100 0 118 C -40 100 -80 60 -80 0 L-80 -80 Z" fill="#22d3ee" fill-opacity="0.08" stroke={u('grad')} stroke-width="3" />
        <rect x="-22" y="-18" width="44" height="38" rx="7" fill={u('grad')} />
        <path d="M-13 -18 v-10 a13 13 0 0 1 26 0 v10" fill="none" stroke={u('grad')} stroke-width="6" />
      </g>
      <g transform="translate(560 170)">
        <rect width="190" height="80" rx="14" fill="#0f1729" stroke="#34d399" stroke-opacity="0.5" />
        <text x="18" y="32" font-size="13" fill="#e2e8f0">workload identity</text>
        <text x="18" y="56" font-size="11.5" fill="#64708a">no static keys</text>
      </g>
      <g font-size="11.5">
        <g transform="translate(560 300)"><rect width="190" height="26" rx="13" fill="#0f1729" stroke="#22d3ee" stroke-opacity="0.4" /><text x="95" y="17" text-anchor="middle" fill="#67e8f9">secrets: vault-backed</text></g>
        <g transform="translate(560 336)"><rect width="190" height="26" rx="13" fill="#0f1729" stroke="#a78bfa" stroke-opacity="0.45" /><text x="95" y="17" text-anchor="middle" fill="#c4b5fd">network: default-deny</text></g>
        <g transform="translate(560 372)"><rect width="190" height="26" rx="13" fill="#0f1729" stroke="#f472b6" stroke-opacity="0.45" /><text x="95" y="17" text-anchor="middle" fill="#f9a8d4">access: least privilege</text></g>
      </g>
    </g>
  )}

  {id === 'observability' && (
    <g font-family={mono}>
      <g transform="translate(50 50)">
        <rect width="700" height="250" rx="16" fill="#0f1729" stroke="#94a3b8" stroke-opacity="0.22" />
        <text x="22" y="34" font-size="13" fill="#e2e8f0">p99 latency</text>
        <text x="678" y="34" text-anchor="end" font-size="12" fill="#64708a">last 6h</text>
        <line x1="22" y1="95" x2="678" y2="95" stroke="#f87171" stroke-opacity="0.6" stroke-dasharray="6 6" />
        <text x="678" y="88" text-anchor="end" font-size="11" fill="#f87171">threshold</text>
        <path d="M22 200 L80 192 L130 198 L180 186 L230 194 L280 182 L320 150 L350 80 L380 72 L410 120 L440 178 L490 188 L540 180 L590 190 L640 184 L678 188" fill="none" stroke={u('grad')} stroke-width="3" stroke-linejoin="round" />
        <path d="M22 200 L80 192 L130 198 L180 186 L230 194 L280 182 L320 150 L350 80 L380 72 L410 120 L440 178 L490 188 L540 180 L590 190 L640 184 L678 188 L678 230 L22 230 Z" fill="#818cf8" fill-opacity="0.08" />
        <circle cx="365" cy="76" r="7" fill="#f87171" class="cv-pulse" />
      </g>
      <g transform="translate(50 322)" font-size="13">
        <rect width="330" height="44" rx="12" fill="#0f1729" stroke="#f87171" stroke-opacity="0.55" />
        <circle cx="22" cy="22" r="6" fill="#f87171" class="cv-blink" />
        <text x="40" y="27" fill="#fca5a5">ALERT latency_p99_high · paged</text>
        <rect x="350" width="330" height="44" rx="12" fill="#0f1729" stroke="#34d399" stroke-opacity="0.55" />
        <circle cx="372" cy="22" r="6" fill="#34d399" />
        <text x="390" y="27" fill="#6ee7b7">RESOLVED · root cause → postmortem</text>
      </g>
    </g>
  )}

  {id === 'ai-gateway' && (
    <g font-family={mono}>
      {['agent-a', 'agent-b', 'agent-c', 'service'].map((n, i) => (
        <g>
          <path d={`M190 ${105 + i * 80} C 290 ${105 + i * 80}, 290 225, 340 225`} fill="none" stroke={u('grad')} stroke-width="2" stroke-opacity="0.75" stroke-dasharray="6 6" class="cv-flow" />
          <rect x="60" y={84 + i * 80} width="130" height="42" rx="10" fill="#111a2b" stroke="#22d3ee" stroke-opacity="0.35" />
          <text x="125" y={110 + i * 80} text-anchor="middle" font-size="12.5" fill="#cbd5e1">{n}</text>
        </g>
      ))}
      {['hosted model', 'hosted model', 'self-hosted'].map((n, i) => (
        <g>
          <path d={`M460 225 C 510 225, 510 ${145 + i * 80}, 600 ${145 + i * 80}`} fill="none" stroke={u('grad')} stroke-width="2" stroke-opacity="0.75" stroke-dasharray="6 6" class="cv-flow" />
          <rect x="600" y={124 + i * 80} width="140" height="42" rx="10" fill="#111a2b" stroke="#c084fc" stroke-opacity="0.4" />
          <text x="670" y={150 + i * 80} text-anchor="middle" font-size="12.5" fill="#cbd5e1">{n}</text>
        </g>
      ))}
      <g transform="translate(340 160)">
        <rect width="120" height="130" rx="18" fill="#0f1729" stroke={u('grad')} stroke-width="2.5" class="cv-pulse" />
        <text x="60" y="34" text-anchor="middle" font-size="13" fill="#e2e8f0">gateway</text>
        <g font-size="10.5" fill="#94a3b8">
          <text x="18" y="62">✓ identity</text>
          <text x="18" y="82">✓ quotas</text>
          <text x="18" y="102">✓ routing</text>
        </g>
      </g>
    </g>
  )}
</svg>
